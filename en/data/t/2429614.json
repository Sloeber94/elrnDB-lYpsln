[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Raise the lever (1a) and undo the bolt (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2052982.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<p>1. Remove the lever (1a) releasing the retainers (1b) and (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2052982.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the lever is undamaged.</p><p>Position the lever attaching the retainers.</p><p>Tighten the bolt.</p>"]]