[[7,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the retaining button.</p><p>2. Remove the trim (2a) releasing the retainers (2b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2044596.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the cover is undamaged.</p><p>Position the trim attaching the retainers.</p><p>Close the retaining button.</p>"]]