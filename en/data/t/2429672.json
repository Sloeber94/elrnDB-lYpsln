[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Open the bonnet lid.</p><p>1. Unscrew the nuts.</p><p>2. Remove the shield.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2045259.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<p>If necessary, \n                                          <a href=\"#/2429674\">7055A84</a>\n                                           .</p>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the radiator badge\nis not damaged.</p><p><a href=\"#/2429674\">7055A84</a></p><p>Position the shield and secure it using\nthe bolts.</p>"]]