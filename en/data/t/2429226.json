[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Proceed with removal \n                                          <a href=\"#/2429219\">4110B14</a>\n                                           .</p><p>1. Loosen the band (1a) and remove the steering box boot (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2044828.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place a new steering box boot\nin its housing and secure it using a new band.</p><p>Proceed with refitting \n                                          <a href=\"#/2429219\">4110B14</a>\n                                           .</p>"]]