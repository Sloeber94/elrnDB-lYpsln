[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Proceed with removal \n                                          <a href=\"#/2429579\">7040A30</a>\n                                           .</p><p>Undo both bolts and remove the underfacia\nbeam lower reinforcement.</p>"],[7,1,0,"<p>Proceed with removal \n                                          <a href=\"#/2428927\">1056B78</a>\n                                           .</p>"],[8,1,0,"<p>Proceed with the removal \n                                          <a href=\"#/2429053\">1060G42</a></p>"],[8,1,0,"<p>1. Release the retaining clips (1a) and disengage the clutch master\ncylinder push rod (1b) from the pedal.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2044741.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,1,0,"<p>1. Remove the stop clip (1a), withdraw the pin (1b) and remove the\nclutch pedal (1c) with spring device.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2044742.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Refit in its seating the clutch\npedal with spring device, then secure it with the pin and retaining\nclip.</p><p>Connect the clutch pedal by replacing in\nits seat and press the pedal fully down.</p>"],[8,1,0,"<p>Proceed with refitting \n                                          <a href=\"#/2429053\">1060G42</a>\n                                           .</p>"],[7,1,0,"<p>Proceed with refitting \n                                          <a href=\"#/2428927\">1056B78</a>\n                                           .</p>"],[7,1,0,"<p>Refit the underfacia beam lower\nreinforcement and tighten the bolts</p><p>Proceed with refitting \n                                          <a href=\"#/2429579\">7040A30</a>\n                                           .</p>"]]