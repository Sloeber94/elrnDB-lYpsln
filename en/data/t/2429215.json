[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Proceed with removal \n                                          <a href=\"#/2429579\">7040A30</a>\n                                           .</p><p>Proceed with removal \n                                          <a href=\"#/2429576\">7040A26</a>\n                                           .</p><p>1. Undo the nut (1a) and remove the steering wheel adjustment adjustment\nlever (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2044806.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the steering wheel position\nadjustment lever in its housing and secure it using the nut.</p><p>Proceed with refitting \n                                          <a href=\"#/2429576\">7040A26</a>\n                                           .</p><p>Proceed with refitting \n                                          <a href=\"#/2429579\">7040A30</a>\n                                           .</p>"]]