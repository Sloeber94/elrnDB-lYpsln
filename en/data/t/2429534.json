[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/2429585\">7040B22</a></p><p>1. Release the seal and remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2045171.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the seal is intact\nand shows no signs of damage.</p><p>Place the seal in position so that the\njoin (1a) is in the centre at the bottom.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2045172.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<p>Check the contact between the\nseal and the tailgate.</p>"]]