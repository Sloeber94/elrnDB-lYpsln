[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Open the tailgate.</p><p>1. Undo the bolts.</p><p>2. Move the tail-light slightly</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2045036.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<p>1. Disconnect the electrical connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Rear left light cluster</p></td><td colspan=\"1\"><p><a href=\"#/2428386\">F30</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Rear right light cluster</p></td><td colspan=\"1\"><p><a href=\"#/2428388\">F31</a></p></td></tr></table></div><p>2. Recover the light cluster.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2045037.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the light cluster\nis not damaged.</p><p>Connect the electrical connection, position\nthe light and secure with bolts.</p><p>Check the operation of the rear light cluster\nlights.</p>"]]